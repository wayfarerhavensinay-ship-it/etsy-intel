const express = require('express');
const session = require('express-session');
const crypto = require('crypto');
const path = require('path');
require('dotenv').config();

const app = express();
const PORT = Number(process.env.PORT || 3003);
const BASE = process.env.ETSY_API_BASE || 'https://api.etsy.com/v3/application';
const KEYSTRING = process.env.ETSY_KEYSTRING;
const SHARED_SECRET = process.env.ETSY_SHARED_SECRET;
const PUBLIC_URL = (process.env.ETSY_PUBLIC_URL || process.env.RENDER_EXTERNAL_URL || '').replace(/\/$/, '');
const REDIRECT_URI = process.env.ETSY_REDIRECT_URI || `${PUBLIC_URL || `http://localhost:${PORT}`}/oauth/redirect`;
const SESSION_SECRET = process.env.SESSION_SECRET || crypto.randomBytes(32).toString('hex');

if (!KEYSTRING || !SHARED_SECRET) {
  console.warn('WARNING: ETSY_KEYSTRING and ETSY_SHARED_SECRET are not set.');
}

app.use(express.json({limit:'1mb'}));
app.set('trust proxy', 1);
app.use(session({secret: SESSION_SECRET, resave:false, saveUninitialized:false, cookie:{httpOnly:true, sameSite:'lax', secure:process.env.NODE_ENV === 'production', maxAge:1000*60*60*24*30}}));
app.use(express.static(path.join(__dirname)));

function apiHeaders(req) {
  if (!KEYSTRING || !SHARED_SECRET) throw new Error('Etsy API credentials are not configured on the server.');
  const h = {'x-api-key': `${KEYSTRING}:${SHARED_SECRET}`};
  if (req.session.etsyAccessToken) h.Authorization = `Bearer ${req.session.etsyAccessToken}`;
  return h;
}

async function etsy(pathname, params={}, req) {
  const u = new URL(BASE + pathname);
  for (const [k,v] of Object.entries(params)) if (v !== undefined && v !== '') u.searchParams.set(k,v);
  const r = await fetch(u, {headers: apiHeaders(req)});
  const text = await r.text();
  if (!r.ok) throw new Error(`Etsy ${r.status}: ${text.slice(0,500)}`);
  return text ? JSON.parse(text) : {};
}

function base64url(buf) { return Buffer.from(buf).toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,''); }
function verifier() { return base64url(crypto.randomBytes(48)); }
function challenge(v) { return base64url(crypto.createHash('sha256').update(v).digest()); }

app.get('/', (req,res) => res.sendFile(path.join(__dirname, 'index.html')));

app.get('/health', (req,res) => res.json({ok:true, service:'etsy-intel'}));

app.get('/api/session', (req,res) => {
  res.json({connected:!!req.session.etsyAccessToken, shopName:req.session.shopName || null});
});

app.get('/auth/etsy', (req,res) => {
  if (!KEYSTRING) return res.status(500).send('ETSY_KEYSTRING is not configured.');
  const v = verifier();
  const state = base64url(crypto.randomBytes(24));
  req.session.pkceVerifier = v;
  req.session.oauthState = state;
  const u = new URL('https://www.etsy.com/oauth/connect');
  u.searchParams.set('response_type','code');
  u.searchParams.set('client_id',KEYSTRING);
  u.searchParams.set('redirect_uri',REDIRECT_URI);
  u.searchParams.set('scope','shops_r listings_r');
  u.searchParams.set('state',state);
  u.searchParams.set('code_challenge',challenge(v));
  u.searchParams.set('code_challenge_method','S256');
  res.redirect(u.toString());
});

app.get('/oauth/redirect', async (req,res) => {
  try {
    if (req.query.error) throw new Error(req.query.error_description || req.query.error);
    if (!req.query.code) throw new Error('Etsy did not return an authorization code.');
    if (!req.session.oauthState || req.query.state !== req.session.oauthState) throw new Error('Invalid OAuth state.');
    const body = new URLSearchParams({
      grant_type:'authorization_code', client_id:KEYSTRING,
      redirect_uri:REDIRECT_URI, code:req.query.code,
      code_verifier:req.session.pkceVerifier
    });
    const r = await fetch('https://api.etsy.com/v3/public/oauth/token', {
      method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error_description || data.error || 'OAuth token request failed');
    req.session.etsyAccessToken = data.access_token;
    req.session.etsyRefreshToken = data.refresh_token;
    req.session.shopName = null;
    delete req.session.pkceVerifier; delete req.session.oauthState;
    res.redirect('/?etsy=connected');
  } catch (e) { res.status(400).send(`<h2>Etsy OAuth error</h2><pre>${escapeHtml(e.message)}</pre><p><a href="/">Back</a></p>`); }
});

app.get('/api/etsy/*', async (req,res) => {
  try {
    if (!req.session.etsyAccessToken) return res.status(401).json({error:'Etsy is not connected. Click Connect Etsy first.'});
    const pathname = req.path.replace(/^\/api\/etsy/,'') || '/';
    const data = await etsy(pathname, req.query, req);
    res.json(data);
  } catch(e) { res.status(502).json({error:e.message}); }
});

app.post('/api/ai/description', async (req,res) => {
  try {
    if (!process.env.ANTHROPIC_API_KEY) return res.status(503).json({error:'ANTHROPIC_API_KEY is not configured on the server.'});
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST', headers:{'content-type':'application/json','x-api-key':process.env.ANTHROPIC_API_KEY,'anthropic-version':'2023-06-01'},
      body:JSON.stringify({model:process.env.ANTHROPIC_MODEL || 'claude-sonnet-4-6', max_tokens:1024, messages:[{role:'user',content:String(req.body.prompt||'')} ]})
    });
    const data = await r.json();
    if (!r.ok) return res.status(r.status).json({error:data.error?.message || 'Anthropic request failed'});
    res.json(data);
  } catch(e) { res.status(500).json({error:e.message}); }
});

function escapeHtml(s) { return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

if (require.main === module) app.listen(PORT, '0.0.0.0', () => console.log(`Etsy Intel running on port ${PORT}`));
module.exports = app;
